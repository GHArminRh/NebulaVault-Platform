DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=nebula_vault
DB_USER=nebula_vault_app
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Gmail SMTP (use a Google App Password; never commit real credentials)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=GArminRh@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DJANGO_DEFAULT_FROM_EMAIL=Nebula Vault <GArminRh@gmail.com>
# Optional: force console or SMTP email backend
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Local payment simulator (no merchant ID, domain, or real payment required).
# Works only when DJANGO_DEBUG=True; never enable it in production.
NEBULA_MOCK_PAYMENTS=True

# Zarinpal v4 Sandbox (real gateway sandbox still needs a valid test merchant ID).
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
ZARINPAL_ENABLED=True
