DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=nebula_vault
DB_USER=nebula_vault_app
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Cloudflare Turnstile (public customer login and registration)
TURNSTILE_ENABLED=True
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend API over HTTPS (preferred on Render; no SMTP port required)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_API_TIMEOUT=15
# onboarding@resend.dev is for limited testing to allowed/verified recipients.
# Verify a domain you control in Resend before public production email delivery.

# SMTP fallback, for hosts that permit outbound SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=

# Optional legacy override; when RESEND_API_KEY is set, Resend takes precedence.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Zarinpal v4 sandbox settings for testing; use your sandbox merchant ID
ZARINPAL_MERCHANT_ID=your-sandbox-merchant-id
ZARINPAL_SANDBOX=True
ZARINPAL_ENABLED=True
