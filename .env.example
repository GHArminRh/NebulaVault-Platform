DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=nebula_vault
DB_USER=nebula_vault_app
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Email provider: auto, resend, brevo, mailersend, smtp, or console.
# "auto" chooses the first configured API key (Resend, Brevo, MailerSend),
# otherwise SMTP when credentials exist, otherwise console in DEBUG mode.
EMAIL_PROVIDER=auto
EMAIL_API_TIMEOUT=15

# Option A: Resend API (HTTPS; recommended for Render's free service)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# onboarding@resend.dev is for initial/testing use only and has recipient limits.
# Verify your own sending domain before public production email delivery.

# Option B: Brevo API (requires a registered/verified sender)
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Option C: MailerSend API (requires a verified sender domain)
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=

# Option D: SMTP, for hosts that allow outbound SMTP (Render free may block it)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=

# Optional legacy override; normally leave unset so EMAIL_PROVIDER controls it.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Zarinpal v4 sandbox settings for testing; use your sandbox merchant ID
ZARINPAL_MERCHANT_ID=your-sandbox-merchant-id
ZARINPAL_SANDBOX=True
ZARINPAL_ENABLED=True
